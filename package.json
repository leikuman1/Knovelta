{
  "name": "knovelta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.9.0 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "recover": "tsx --env-file-if-exists=.env.local scripts/recover.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.87",
    "ai": "6.0.316",
    "better-sqlite3": "13.0.3",
    "diff": "8.0.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
